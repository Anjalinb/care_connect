#API call for listing all doctors
###
GET http://127.0.0.1:8000/doctors/
Accept: application/json

#API call for inserting new doctor
###
POST http://127.0.0.1:8000/doctors/
Content-Type: application/json

{
    "name":"navami",
    "specialization":"Dermatology",
    "fee":1000,
    "qualification":"mbbs",
    "email":"navami@gmail.com"
}

#API call for retrieving doctor details
###
GET http://127.0.0.1:8000/doctors/2/
Accept: application/json

#API call for updating a doctor
###
PUT http://127.0.0.1:8000/doctors/4/
Content-Type: application/json

{
    "name":"navami",
    "specialization":"dermatology",
    "fee":1100,
    "qualification":"mbbs",
    "email":"navami@gmail.com"
}

#API call for deleting a doctor
###
DELETE http://127.0.0.1:8000/doctors/3/
Accept: application/json

#V2 END POINTS

#API call for listing all doctors
###
GET http://127.0.0.1:8000/v2/doctors/
Accept: application/json
Authorization: Basic adminuser:admin


#API call for inserting new doctor
###
POST http://127.0.0.1:8000/v2/doctors/
Content-Type: application/json
Authorization: Basic adminuser:admin

{
    "name":"hiba",
    "specialization":"dermatology",
    "fee":700,
    "qualification":"mbbs",
    "email":"hiba@gmail.com"
}

#API call for retrieving doctor details
###
GET http://127.0.0.1:8000/v2/doctors/2/
Accept: application/json
Authorization: Basic adminuser:admin

#API call for updating a doctor
###
PUT http://127.0.0.1:8000/v2/doctors/4/
Content-Type: application/json
Authorization: Basic adminuser:admin

{
    "name":"navami",
    "specialization":"dermatology",
    "fee":600,
    "qualification":"mbbs",
    "email":"navami@gmail.com"
}

#API call for deleting a doctor
###
DELETE http://127.0.0.1:8000/v2/doctors/5/
Accept: application/json
Authorization: Basic adminuser:admin

#API call for creating admin user
###
POST http://127.0.0.1:8000/v2/admin-register/
Content-Type: application/json


{
    "username":"adminuser",
    "email":"admin@gmail.com",
    "password":"admin"
}



#API call for listing all appointments
###
GET http://127.0.0.1:8000/appointments/
Accept: application/json

#API call for creating new appointment
###
POST http://127.0.0.1:8000/appointments/
Content-Type: application/json

{
    "patient_name":"sanya",
    "phone":"9876789765",
    "doctor":2,
    "appointment_date":"2026-10-08",
    "problem":"wheezing"
}

#API call for registering new user
###
POST http://127.0.0.1:8000/v2/booking/signup/
Content-Type: application/json

{
    "username":"django",
    "password":"django123",
    "email":"django@gmail.com"
}

#APPOINTMENTS V2
#API call for listing all appointments
###
GET http://127.0.0.1:8000/v2/booking/appointments/
Accept: application/json
Authorization: Basic django:django123

#API call for creating new appointment
###
POST http://127.0.0.1:8000/v2/booking/appointments/
Content-Type: application/json
Authorization: Basic django:django123

{
    "patient_name":"sayana ",
    "phone":"9084789765",
    "doctor":4,
    "appointment_date":"2026-10-08",
    "problem":"sneeing"
}

#API call for retrieving appointment details
###
GET http://127.0.0.1:8000/v2/booking/appointments/1/
Accept: application/json
Authorization: Basic django:django123

#API call for updating appointment
###
PUT http://127.0.0.1:8000/v2/booking/appointments/6/
Content-Type: application/json
Authorization: Basic django:django123

{
   "patient_name":"sayana ",
    "phone":"9084789765",
    "doctor":2,
    "appointment_date":"2026-10-08",
    "problem":"sneeing" 
}

#API call for deleting appointment
###
DELETE http://127.0.0.1:8000/v2/booking/appointments/6/
Accept: application/json
Authorization: Basic django:django123

